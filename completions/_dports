#compdef dports
# Zsh completion for dports

local -a update_opts main_opts
update_opts=(
    '(--yes -y)--check[only report the status of each image]'
    '(--check -y --yes)'{-y,--yes}'[pull every image that has an update]'
    '(--check)--recreate[recreate outdated Compose services after pulling]'
    '(-c --color -C --no-color)'{-c,--color}'[force color output]'
    '(-c --color -C --no-color)'{-C,--no-color}'[disable color output]'
    '(- *)'{-h,--help}'[show help]'
)
main_opts=(
    '(-v --verbose)'{-v,--verbose}'[show the internal port too]'
    '(-a --all)'{-a,--all}'[include stopped containers]'
    '(-p --port)'{-p,--port}'[filter by host port]:port: '
    '(-n --name)'{-n,--name}'[filter by container name]:name:'
    '(-i --image)'{-i,--image}'[filter by image name]:image:'
    '(-c --color -C --no-color)'{-c,--color}'[force color output]'
    '(-c --color -C --no-color)'{-C,--no-color}'[disable color output]'
    '(-t --tunnel)'{-t,--tunnel}'[also show Cloudflare Tunnel routes]'
    '(-q --quiet -j --json -I --interactive)'{-q,--quiet}'[only show port numbers]'
    '(-q --quiet -j --json -I --interactive)'{-j,--json}'[output JSON]'
    '(-q --quiet -j --json -I --interactive)'{-I,--interactive}'[browse ports interactively (experimental)]'
    '(- *)'{-h,--help}'[show help]'
    '(- *)'{-V,--version}'[show version]'
)

local upd=${words[(I)update]}
if (( upd > 1 && upd < CURRENT )); then
    # Complete the subcommand's options as if "update" were the command
    shift $(( upd - 1 )) words
    (( CURRENT -= upd - 1 ))
    _arguments -s $update_opts
else
    _arguments -s $main_opts '1::subcommand:((update\:"check images for updates, pull and recreate"))'
fi
